# Vercel frontend -> Render signaling server
NEXT_PUBLIC_SIGNALING_URL=wss://YOUR-RENDER-SERVICE.onrender.com

# Optional TURN server for networks where STUN is not enough.
# These values are exposed to the browser, so use short-lived/ephemeral credentials in production.
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server:3478
# NEXT_PUBLIC_TURN_USERNAME=your-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-credential
